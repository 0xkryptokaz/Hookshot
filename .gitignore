# ---- never commit the game or anything made from it ----
# (decompressed modules, the loaded image, lifted C, test builds, romfs/exefs copies, dumps, keys)
work/*
gen/
image/
exefs/
romfs/
*.bin
*.keys
*.nso
*.nca
*.nsp
*.xci
gamefile/
*.nup
*.nsz
*.xcz
# (but the pipeline state list a release ships: shader hashes and draw state, no game code. nx2/pipeline_states.py)
!work/pipeline_states.bin

# ---- build output and caches ----
build/
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.sha1
*.log

# ---- Linux builds ----
build-linux/
*.so

# ---- NVIDIA's DLSS SDK (scripts/ngx_sdk.py): NVIDIA's files, never committed ----
ngx-sdk/
